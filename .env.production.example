# Copiar como .env en el servidor tecnoweb y completar APP_KEY y DB_PASSWORD.
APP_NAME="FEDER"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tecnoweb.org.bo/inf513/grupo28sa/proyecto2
ASSET_URL=https://www.tecnoweb.org.bo/inf513/grupo28sa/proyecto2
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# En el servidor la base de datos es local
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_grupo28sa
DB_USERNAME=grupo28sa
DB_PASSWORD=

# Cache y sesiones en la BD: Apache corre con otro usuario y no puede escribir archivos del grupo
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/inf513/grupo28sa/proyecto2
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
